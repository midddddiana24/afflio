# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Used for admin actions that must bypass RLS (payment approval, manual
# token adjustments). Get it from Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run supabase:types` to generate lib/supabase/types.ts
SUPABASE_PROJECT_ID=your-project-ref
