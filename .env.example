# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Used for admin actions that must bypass RLS (payment approval, manual
# token adjustments). Get it from Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run supabase:types` to generate lib/supabase/types.ts
SUPABASE_PROJECT_ID=your-project-ref

# Public production origin used for QR codes, auth redirects, and webhooks.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Provision these before enabling checkout, queueing, or monitoring.
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
CLICK_QUEUE_SECRET=
# Random server-only secret used to HMAC visitor IPs for unique-click detection.
CLICK_HASH_SECRET=
SENTRY_DSN=

# Optional credentials for authenticated Playwright tests.
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
